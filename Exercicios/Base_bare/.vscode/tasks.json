{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
            "args": ["-C", "${workspaceFolder}/build"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            }
        },
        {
            "label": "Flash (J-Link)",
            "type": "process",
            "command": "C:/Program Files/SEGGER/JLink_V986a/JLink.exe",
            "args": [
                "-device", "RP2350A_RV32_0",
                "-if", "SWD",
                "-speed", "4000",
                "-autoconnect", "1",
                "-NoGui", "1",
                "-CommandFile", "${workspaceFolder}/.vscode/flash.jlink"
            ],
            "problemMatcher": []
        }
    ]
}
