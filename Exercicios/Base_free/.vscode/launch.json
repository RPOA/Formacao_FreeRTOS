{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (J-Link)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "C:/Program Files/SEGGER/JLink_V986a/JLinkGDBServerCL.exe",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "RP2350_RV32_0",
            "interface": "swd",
            "serialNumber": "",
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset",
                "load \"${command:raspberry-pi-pico.launchTargetPath}\""
            ]
        }
    ]
}